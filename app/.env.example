# Airtable Configuration (Local Development Only)
#
# IMPORTANT: This file is for reference only. Create a local .env file with your actual credentials.
# NEVER commit the .env file with real credentials to version control.
#
# These credentials are only used by the `npm run update-data` script to fetch
# camp data from Airtable. They are NOT included in production builds.
#
# To get your credentials:
# 1. Base ID: Found in Airtable API docs or URL (starts with "app...")
# 2. Table Name: Usually "2025" for current year, or your specific table name
# 3. PAT: Create at https://airtable.com/create/tokens with data.records:read scope

VITE_AIRTABLE_BASE_ID=your_base_id_here
VITE_AIRTABLE_TABLE_NAME=2025
VITE_AIRTABLE_PAT=your_personal_access_token_here

# Example:
# VITE_AIRTABLE_BASE_ID=app8o7hgpxr6xx2Rt
# VITE_AIRTABLE_TABLE_NAME=2025
# VITE_AIRTABLE_PAT=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
